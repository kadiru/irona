# Keep the API key only in the private .env file on Ubuntu.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EST9Ui6982FZPSi7gCHi
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

IRONA_HOST=127.0.0.1
IRONA_PORT=8000
IRONA_AUDIO_OUTPUT=desktop
# Temi mode requires the installed player, private pairing token, and ADB forward.
IRONA_TEMI_URL=http://127.0.0.1:8766
# Ubuntu analog line-out: development output, not robot integration.
IRONA_AUDIO_SINK=alsa_output.pci-0000_00_1f.3.analog-stereo
IRONA_VOLUME=60
IRONA_HISTORY_TURNS=6
IRONA_SYSTEM_PROMPT=irona/system_prompt.txt
IRONA_LLM_TIMEOUT=90
IRONA_TTS_TIMEOUT=45
IRONA_PLAYBACK_TIMEOUT=45
